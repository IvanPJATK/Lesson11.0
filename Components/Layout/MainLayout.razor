@inherits LayoutComponentBase
@inject BlazorLesson1.Services.StateContainer State

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 bg-light shadow-sm d-flex justify-content-between align-items-center">
            <span class="text-secondary fw-semibold">Academic Management Workspace</span>
            <div class="badge bg-primary fs-6 p-2">
                Observed Students: <span class="fw-bold">@State.ObservedStudents.Count</span>
            </div>
        </div>

        <div class="content px-4 py-3">
            @Body
        </div>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
}